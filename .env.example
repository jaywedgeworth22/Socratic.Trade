OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_URL=
# "mock"/unset leaves Robinhood disconnected; "mcp" enables the real MCP path.
ROBINHOOD_ADAPTER=mock
DATABASE_URL=file:./data/app.db

# Optional secret delivery through Infisical CLI wrappers.
# Use npm run dev:secrets / build:secrets / start:secrets after configuring these.
INFISICAL_PROJECT_ID=
INFISICAL_ENV=dev
INFISICAL_PATH=/
INFISICAL_WATCH=false

# Master key for AES-256-GCM encryption of per-user API keys stored in the DB
# (user_api_keys table). MUST be a stable 32-byte hex string (64 hex chars), and MUST be
# set for any persistent/multi-user deployment: if unset, a RANDOM key is generated per
# process, so every previously-stored key becomes undecryptable after a restart.
# Generate one with:  openssl rand -hex 32
ENCRYPTION_KEY=
MARKET_SCAN_LIMIT=30
MARKET_SCAN_CACHE_TTL_MS=300000
MARKET_SCAN_EVENT_RESERVE=8
HISTORY_TTL_MS=1800000
MARKET_DATA_PENDING_TTL_MS=1800000
# Shared/env-key OHLC history is cached globally. User-saved keyed history is private
# by default; set on only after confirming data-sharing/entitlement policy.
MARKET_DATA_SHARE_USER_KEYED_HISTORY=off

# Required only when ROBINHOOD_ADAPTER=mcp. URL defaults to Robinhood's official
# Trading MCP endpoint if unset.
ROBINHOOD_MCP_URL=https://agent.robinhood.com/mcp/trading
ROBINHOOD_MCP_PROTOCOL_VERSION=2025-03-26
ROBINHOOD_MCP_AUTH_TOKEN=

# Optional OAuth flow for hosted Robinhood MCP servers that do not use a static token.
# Visit /api/auth/robinhood/start on desktop to complete consent.
ROBINHOOD_MCP_AUTHORIZATION_URL=
ROBINHOOD_MCP_TOKEN_URL=
ROBINHOOD_MCP_CLIENT_REGISTRATION_URL=
ROBINHOOD_MCP_CLIENT_NAME=
ROBINHOOD_MCP_CLIENT_ID=
ROBINHOOD_MCP_CLIENT_SECRET=
ROBINHOOD_MCP_REDIRECT_URI=http://localhost:3000/api/auth/robinhood/callback
ROBINHOOD_MCP_SCOPES=tools:call

# Optional broker account credentials. Connected accounts entered in Accounts take
# precedence. Paper accounts are optional and user-selected.
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=

# Company logo sources.
# logo.dev publishable token — used as a cascade fallback when the primary
# GitHub ticker-logos source returns 404. Two fetch strategies are available:
#   1. By ticker: img.logo.dev/ticker/AAPL  (used automatically when set)
#   2. By domain: img.logo.dev/apple.com    (wired if you supply a domain map)
# Free tier: 500k requests/month; requires attribution for commercial use.
# Get a token at https://logo.dev
LOGO_DEV_TOKEN=

# Optional market-data / enrichment keys.
FINNHUB_API_KEY=
FMP_API_KEY=
FMP_MAX_SYMBOLS=15
NEWS_CACHE_TTL_MS=21600000
ALPHAVANTAGE_API_KEY=
FINTECH_STUDIOS_API_KEY=
FINTECH_STUDIOS_BASE_URL=
FRED_API_KEY=
TRADIER_API_KEY=
TRADIER_BASE_URL=https://api.tradier.com
MARKETSTACK_API_KEY=

# Experimental, disabled by default. Uses the unofficial community Python package
# `webull` for read-only quote enrichment only; never for orders or learning fills.
# Requires: pip install webull
WEBULL_UNOFFICIAL_ENABLED=off
WEBULL_UNOFFICIAL_PYTHON=python3
WEBULL_UNOFFICIAL_SCRIPT=
WEBULL_UNOFFICIAL_MAX_SYMBOLS=20
WEBULL_UNOFFICIAL_TIMEOUT_MS=8000

# Optional public web-source / technical controls.
SEC_EDGAR_USER_AGENT=
WEB_SOURCE_RETRY_BACKOFF_MS=
WEB_SOURCE_CONGRESS=on
WEB_SOURCE_CONGRESS_TTL_MS=
WEB_SOURCE_CONGRESS_WINDOW_DAYS=
WEB_SOURCE_CONGRESS_LOOKBACK_DAYS=
WEB_SOURCE_CONGRESS_MAX_FILINGS=
WEB_SOURCE_CAPITOLTRADES_URL=
WEB_SOURCE_INSIDER=on
WEB_SOURCE_INSIDER_TTL_MS=
WEB_SOURCE_INSIDER_WINDOW_DAYS=
WEB_SOURCE_INSIDER_MAX_FILINGS=
WEB_SOURCE_FINRA=on
WEB_SOURCE_FINRA_TTL_MS=
WEB_SOURCE_SEC8K=on
WEB_SOURCE_SEC8K_TTL_MS=
WEB_SOURCE_SEC8K_WINDOW_DAYS=
WEB_SOURCE_SEC8K_DETAIL_LIMIT=
WEB_SOURCE_SEC8K_RAG_LIMIT=16
WEB_SOURCE_TECHNICAL=on
WEB_SOURCE_TECHNICAL_TTL_MS=
WEB_SOURCE_TECHNICAL_MAX=40
TECHNICAL_SOURCE=computed
TRADINGVIEW_WEBHOOK_SECRET=
TRADINGVIEW_WEBHOOK_IPS=

# Optional RAG context for filings/research.
VOYAGE_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_INDEX_READY_WAIT_MS=
VECTOR_EMBED_BATCH_SIZE=8
VECTOR_EMBED_BATCH_DELAY_MS=21000
VECTOR_EMBED_RETRY_ATTEMPTS=2
VECTOR_EMBED_RETRY_DELAY_MS=20000
VECTOR_CONTEXT_MAX_CHARS=2400

# Optional/future bulk-data settings.
MASSIVE_API_KEY=
MASSIVE_API_BASE=
MASSIVE_REST_MAX_CALLS_PER_MINUTE=5
MASSIVE_HISTORY_ENABLED=on
MASSIVE_NEWS_TTL_MS=1800000
MASSIVE_BREADTH_MAX_DATE_PROBES=5
MASSIVE_S3_ENDPOINT=
MASSIVE_BUCKET=
MASSIVE_ACCESS_KEY_ID=
MASSIVE_SECRET_ACCESS_KEY=

# Optional notifications.
WEBHOOK_URL=

# Optional Sentry server/edge error/performance telemetry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
# Reserved for a follow-up after the Sentry Next.js build wrapper is revalidated:
# NEXT_PUBLIC_SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_REPLAY_ENABLED=false
# NEXT_PUBLIC_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0
# NEXT_PUBLIC_SENTRY_REPLAY_ERROR_SAMPLE_RATE=1
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Optional Langfuse LLM observability. Default capture mode stores summaries/counts and
# redacted proposal metadata, not raw prompts, positions, account numbers, or API keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_ENABLED=on
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=
LANGFUSE_CAPTURE_IO=summary

# Optional SQLite physical replication via Litestream CLI.
LITESTREAM_DB_PATH=data/app.db
LITESTREAM_REPLICA_URL=
